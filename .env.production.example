# =============================================================================
# Autobot Brain OS — Production Environment Variables for Vercel
# =============================================================================
# Copy this file to .env.production.local for local development
# Add these environment variables in your Vercel dashboard for production
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (Vercel Postgres or external database)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@host:5432/autobot_brain_os

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# CLERK AUTHENTICATION  (https://clerk.com)
# ─────────────────────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Vite) — prefix with VITE_ to expose to browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH  (https://console.cloud.google.com)
# Scopes needed: gmail.readonly, calendar.readonly, userinfo.email, userinfo.profile
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/integrations/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# ─────────────────────────────────────────────────────────────────────────────
# GEMINI AI  (Google AI Studio)
# ─────────────────────────────────────────────────────────────────────────────
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY  (https://dashboard.razorpay.com)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Expose key ID to frontend (never expose key secret)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

# Plan IDs from Razorpay dashboard (for subscription-based billing)
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_ENTERPRISE=plan_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# JIRA  (https://id.atlassian.com/manage-profile/security/api-tokens)
# ─────────────────────────────────────────────────────────────────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=founder@yourcompany.com
JIRA_API_TOKEN=ATATxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT_KEY=ABOS                # Project key for Autobot Brain OS

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Slack Webhook for Jira-to-Slack notifications
# ─────────────────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
